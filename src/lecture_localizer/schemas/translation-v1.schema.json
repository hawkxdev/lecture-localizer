{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://raw.githubusercontent.com/hawkxdev/lecture-localizer/main/src/lecture_localizer/schemas/translation-v1.schema.json",
  "title": "Lecture translation input",
  "description": "Reviewed complete Russian translation bound to one video and its source SRT cues.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "source",
    "source_language",
    "target_language",
    "segments"
  ],
  "properties": {
    "schema_version": {
      "const": 1
    },
    "source": {
      "type": "object",
      "additionalProperties": false,
      "required": ["video_sha256", "srt_sha256"],
      "properties": {
        "video_sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "srt_sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        }
      }
    },
    "source_language": {
      "const": "en"
    },
    "target_language": {
      "const": "ru"
    },
    "segments": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "source_cues", "translation"],
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1
          },
          "source_cues": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "integer",
              "minimum": 1
            }
          },
          "translation": {
            "type": "string",
            "minLength": 1
          },
          "narration": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    }
  }
}
