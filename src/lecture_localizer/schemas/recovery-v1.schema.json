{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Local validation of a retained speech response",
  "description": "An immutable local receipt referencing an unchanged historical failed HTTP attempt and separately derived canonical WAV. It never represents a new provider request.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "operation_id",
    "attempt",
    "segment_id",
    "synthesis_signature",
    "request_signature",
    "posted_text_sha256",
    "attempt_sha256",
    "source",
    "artifact",
    "canonical",
    "validated_at"
  ],
  "properties": {
    "schema_version": {
      "const": 1
    },
    "operation_id": {
      "type": "string",
      "pattern": "^[0-9a-f]{32}$"
    },
    "attempt": {
      "type": "integer",
      "minimum": 1
    },
    "segment_id": {
      "type": "string",
      "minLength": 1
    },
    "synthesis_signature": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "request_signature": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "posted_text_sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "attempt_sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "source": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "path",
        "sha256",
        "bytes"
      ],
      "properties": {
        "path": {
          "type": "string",
          "pattern": "^(?!.*\\.\\.)[A-Za-z0-9_][A-Za-z0-9_/.-]*$"
        },
        "sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "bytes": {
          "type": "integer",
          "minimum": 1
        }
      }
    },
    "artifact": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "path",
        "sha256",
        "bytes"
      ],
      "properties": {
        "path": {
          "type": "string",
          "pattern": "^(?!.*\\.\\.)[A-Za-z0-9_][A-Za-z0-9_/.-]*$"
        },
        "sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "bytes": {
          "type": "integer",
          "minimum": 1
        }
      }
    },
    "canonical": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "path",
        "sha256",
        "bytes"
      ],
      "properties": {
        "path": {
          "type": "string",
          "pattern": "^(?!.*\\.\\.)[A-Za-z0-9_][A-Za-z0-9_/.-]*$"
        },
        "sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "bytes": {
          "type": "integer",
          "minimum": 1
        }
      }
    },
    "validated_at": {
      "type": "string",
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}(\\.[0-9]+)?(Z|[+-][0-9]{2}:[0-9]{2})$"
    }
  }
}
